<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TelaGerenciarUsuarios">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usuários"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#018D3E"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCadastrarNovoUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar novo usuário"
        android:backgroundTint="#018D3E"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etBuscarUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar usuário por nome ou matrícula…"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgFiltroUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos"
            android:checked="true"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professores"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alunos" />
    </RadioGroup>

    <ListView
        android:id="@+id/lvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
