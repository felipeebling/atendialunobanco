<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TelaGerenciarUsuarios">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerenciar Alunos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#018D3E"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etNomeAluno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome completo do Aluno"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etEmailAluno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E-mail do Aluno"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etTurmaAluno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Turma / Matrícula"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCadastrarAluno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar Aluno"
        android:backgroundTint="#018D3E"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSalvaAlteracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#018D3E"
        android:text="Salvar Aluno"
        android:textColor="#FFFFFF"
        android:visibility="invisible" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alunos Cadastrados"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#018D3E"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
