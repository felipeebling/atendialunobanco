<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TelaHistoricoAtendimentos">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Histórico e Acompanhamento"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#018D3E"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etPesquisarHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pesquisar registros..."
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgFiltroHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todos"
            android:checked="true"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Realizados"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelados" />
    </RadioGroup>

    <ListView
        android:id="@+id/lvHistorico"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
