<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TelaHistoricoAtendimentos">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Acompanhamentos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#018D3E"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spFiltroSituacao"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etFiltroData"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Data (ex: 14/11)"
            android:inputType="date" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPesquisarHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pesquisar por aluno ou disciplina..."
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/lvHistorico"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
